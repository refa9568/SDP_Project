# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# For LOCAL MongoDB: mongodb://localhost:27017/paradeops_db
# For REMOTE MongoDB: mongodb://192.168.X.X:27017/paradeops_db (replace with actual IP)
MONGODB_URI=mongodb://localhost:27017/paradeops_db

# JWT Secret
JWT_SECRET=paradeops_secret_key_2026_change_in_production
JWT_EXPIRE=24h

# CORS
CORS_ORIGIN=http://localhost:8000
